PORT=3000

BROKER_PROVIDER=tradestation

TRADESTATION_CLIENT_ID=
TRADESTATION_CLIENT_SECRET=
TRADESTATION_REFRESH_TOKEN=
TRADESTATION_ACCOUNT_ID=
TRADESTATION_SIM_URL=https://sim.api.tradestation.com
TRADESTATION_LIVE_URL=https://api.tradestation.com
TRADESTATION_SIGNIN_URL=https://signin.tradestation.com

# Charts Watcher integration
# Set CW_ENABLED=false to skip the scanner connection (broker keeps working).
CW_ENABLED=true
CW_WS_URL=wss://app.chartswatcher.com/api/v1/websocket
CW_USER_ID=
CW_API_KEY=
# Charts Watcher scanner config_id to subscribe to.
CW_CONFIG_ID=
