NODE_ENV=development
LOG_LEVEL=info
PORT=3000

BROKER_PROVIDER=tradestation

TRADESTATION_CLIENT_ID=
TRADESTATION_CLIENT_SECRET=
TRADESTATION_REFRESH_TOKEN=
TRADESTATION_ACCOUNT_ID=
TRADESTATION_SIM_URL=https://sim.api.tradestation.com
TRADESTATION_LIVE_URL=https://api.tradestation.com
TRADESTATION_SIGNIN_URL=https://signin.tradestation.com

# Charts Watcher integration
# Set CW_ENABLED=false to skip the scanner connection (broker keeps working).
CW_ENABLED=true
CW_WS_URL=wss://app.chartswatcher.com/api/v1/websocket
CW_USER_ID=
CW_API_KEY=
# Charts Watcher scanner config_id to subscribe to.
CW_CONFIG_ID=

# Indicators provider (alphavantage | twelvedata | local)
# 'local' computes indicators in-process from the bar cache fed by Polygon's
# realtime WS — requires POLYGON_API_KEY and REDIS_URL.
INDICATOR_PROVIDER=alphavantage
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
# Minimum spacing between requests to stay under AV's 10 req/s burst cap.
ALPHA_VANTAGE_MIN_INTERVAL_MS=250

# Twelve Data — RTH-only MACD by default (matches TradingView).
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com
# Minimum spacing between requests. Adjust to your plan's cap: free=7500 (8/min), paid 155/min=400.
TWELVEDATA_MIN_INTERVAL_MS=400

# Polygon (realtime market data feed — WS only, channel AM)
# Required when MARKET_FEED=polygon. Historical bootstrap goes to Twelve Data.
POLYGON_API_KEY=
POLYGON_WS_URL=wss://socket.polygon.io/stocks
# Bars to bootstrap per (symbol, interval) when a new symbol enters the watchlist.
# Historical bootstrap is fetched from Twelve Data, not Polygon.
BOOTSTRAP_BARS=200

# Decision model
# Set DECISION_ENABLED=false to keep the API up but skip the auto evaluation loop.
DECISION_ENABLED=true
DECISION_MODEL=technical
# Market feed mode (none | polygon)
# 'polygon' replaces the per-minute DecisionRunner with a BarStreamManager that
# evaluates symbols event-driven on each AM bar close. Implies INDICATOR_PROVIDER=local.
MARKET_FEED=none

# Redis (watchlist persistence). If unset → in-memory fallback.
REDIS_URL=

# Bearer token to protect /api/* routes. If unset → /api/* returns 503 (fail-closed).
# Generate with: openssl rand -hex 32
API_TOKEN=

# Better Stack (logs + heartbeat)
LOGTAIL_SOURCE_TOKEN=
BETTERSTACK_HEARTBEAT_URL=

# Grafana Cloud Free (Prometheus remote_write). If any unset → metrics stay local at /metrics.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_PROM_API_KEY=
