{
  "name": "cw-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "oauth:refresh-token": "tsx --env-file=.env scripts/get-refresh-token.ts",
    "redis:flush": "tsx --env-file=.env scripts/flush-redis.ts",
    "db:init-scanner-alerts": "tsx --env-file=.env scripts/init-scanner-alerts.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@logtail/pino": "^0.5.8",
    "fastify": "^5.2.1",
    "ioredis": "^5.10.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "prometheus-remote-write": "^0.5.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "lint-staged": "^17.0.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
